									"pm.test(`Products are sorted by ${sortKey} ${sortOrder}`, () => {\r",
									"  for (let i = 1; i < products.length; i++) {\r",
									"    const prev = products[i - 1][sortKey];\r",
									"    const curr = products[i][sortKey];\r",
									"\r",
									"    if (sortOrder === \"ASC\") {\r",
									"      pm.expect(prev).to.be.at.most(curr);\r",
									"    } else {\r",
									"      pm.expect(prev).to.be.at.least(curr);\r",
									"    }\r",
									"  }\r",
